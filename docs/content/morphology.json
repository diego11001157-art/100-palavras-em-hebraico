  "quickRules": [
    {
      "title": "Perfeito",
      "text": "Reconheça principalmente pelos aformativos (terminações). Eles carregam pessoa, gênero e número."
    },
    {
      "title": "Imperfeito",
      "text": "Procure primeiro os preformativos א / נ / י / ת e depois possíveis terminações."
    },
    {
      "title": "Imperativo",
      "text": "No modelo básico ocorre na 2ª pessoa; compare com o imperfeito sem o preformativo, mas confirme a forma."
    },
    {
      "title": "Número ≠ estado",
      "text": "Singular/plural é número. Absoluto/construto é estado nominal: são duas perguntas diferentes."
    },
    {
      "title": "Infinitivo construto ≠ estado construto",
      "text": "“Infinitivo construto” é categoria verbal; “estado construto” pertence à morfologia nominal."
    }
  ]
